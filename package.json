{
  "name": "growth-skills",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run dev:web",
    "build": "bun run skills:package && bun run --filter web build",
    "check-types": "bun run --filter web check-types",
    "dev:web": "bun run --filter web dev:bare",
    "deploy": "bun run build:cloudflare && bun run deploy:built",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "skills:package": "bun scripts/package-skills.ts",
    "skills:validate": "bun scripts/validate-skills.ts",
    "build:cloudflare": "bun run build",
    "deploy:built": "bun run --filter web deploy:built",
    "verify": "bun run skills:validate && bun run build && bun run check-types"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@growth-skills/config": "workspace:*",
    "@types/node": "catalog:",
    "fflate": "^0.8.3",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
